{
  "expo": {
    "name": "sylab",
    "slug": "sylab-app",
    "version": "1.5.0",
    "orientation": "portrait",
    "scheme": "sylab",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sylab.app",
      "infoPlist": {
        "NSCameraUsageDescription": "\u5141\u8bb8\u8bbf\u95ee\u76f8\u673a\u4ee5\u62cd\u6444\u7167\u7247",
        "NSPhotoLibraryUsageDescription": "\u5141\u8bb8\u8bbf\u95ee\u7167\u7247\u4ee5\u4e0a\u4f20\u6587\u4ef6",
        "NSMicrophoneUsageDescription": "\u5141\u8bb8\u4f7f\u7528\u9ea6\u514b\u98ce\u8fdb\u884c\u8bed\u97f3\u8f93\u5165"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#6030ff"
      },
      "package": "com.sylab.app",
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "\u5141\u8bb8\u8bbf\u95ee\u7167\u7247\u4ee5\u4e0a\u4f20\u6587\u4ef6",
          "cameraPermission": "\u5141\u8bb8\u62cd\u6444\u7167\u7247"
        }
      ],
      [
        "expo-document-picker",
        {
          "iCloudContainerEnvironment": "Production"
        }
      ],
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {}
    }
  }
}